# Android Release Signing Configuration
# Copy this file to key.properties and fill in your values
# DO NOT commit key.properties to version control!

# Path to your keystore file (relative to android/ folder or absolute)
storeFile=upload-keystore.jks

# Keystore password
storePassword=your_store_password

# Key alias (name you gave when creating the key)
keyAlias=upload

# Key password
keyPassword=your_key_password

# ---
# To generate a new keystore, run:
# keytool -genkey -v -keystore upload-keystore.jks -keyalg RSA -keysize 2048 -validity 10000 -alias upload
