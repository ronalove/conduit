# Configuration pour le service d'inscription Knights Network
# Copiez ce fichier en .env et remplissez les valeurs

# Token d'authentification pour l'API Ergo (requis)
# Generer avec: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ERGO_API_TOKEN=

# URL de l'API Ergo (optionnel, defaut: http://ergo:8089)
ERGO_API_URL=http://ergo:8089
